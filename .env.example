# ═══════════════════════════════════════════════════
#  SmartRoute v2.0 — Environment Variables
#  Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════

# ── Server ──────────────────────────────────────────
PORT=8787

# ── AI Provider (mock works without any key) ────────
# Options: "mock" | "claude" | "openai"
AI_PROVIDER=mock
AI_API_KEY=sk-ant-api03-REPLACE_WITH_YOUR_CLAUDE_KEY
AI_BASE_URL=https://api.anthropic.com/v1/messages
AI_MODEL=claude-sonnet-4-6

# ── JWT Authentication ───────────────────────────────
# Any long random string — used to sign tokens
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_STRING
JWT_EXPIRES_IN=7d

# ── Stripe Payments (optional for dev) ──────────────
# Get keys at: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_STRIPE_TEST_KEY
# Get from Stripe Webhook dashboard after adding endpoint
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_AFTER_WEBHOOK_SETUP

# ── CORS & App URL ──────────────────────────────────
# In production, set to your actual domain
CORS_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173
